# Suppressing the readline library leaks that are allowed for the minishell project (readline and readline/history functionalities)
# To use it with Valgrind, we should add --suppressions=readline.supp (or --suppressions=path_to_readline.supp if our file is not in the main directory)

# Example usage: valgrind --leak-check=full -s --show-leak-kinds=all --track-origins=yes --suppressions=readline.supp ./minishell

{
	suppress_readline_leaks
	Memcheck:Leak
	...
	fun:readline
}

{
	suppress_readline_add_history_leaks
	Memcheck:Leak
	...
	fun:add_history
}